<mujoco model="ridgeback">
  <compiler angle="radian" meshdir="../meshes/"/>

  <default>
    <default class ="wheel">
       <joint damping="0.05" armature="0.01" frictionloss="0.5"/>
    </default>

    <default class ="size3">
       <joint damping="2" armature="0.1" frictionloss="0.5"/>
    </default>

    <default class ="size1">
       <joint damping="0.5" armature="0.01" frictionloss="0.5"/>
    </default>

    <motor nsample="5" delay="0.01" />
  </default>

  <asset>
    <mesh name="rocker" content_type="model/stl" file="base/rocker.stl"/>
    <mesh name="wheel" content_type="model/stl" file="base/wheel.stl"/>
    <mesh name="body" content_type="model/stl" file="base/body.stl"/>
