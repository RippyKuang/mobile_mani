            <geom quat="0.707107 0.707107 0 0" type="mesh" contype="0" conaffinity="0" group="1" rgba="0.15 0.15 0.15 1" density="0" mesh="wheel"/>
            <geom size="0.0759 0.0395" quat="0.707107 0.707107 0 0" friction="0.5 0.005 0.02" type="cylinder" rgba="0.15 0.15 0.15 1"/>
