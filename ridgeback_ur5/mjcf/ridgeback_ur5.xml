    <mesh name="forearm" content_type="model/stl" file="ur5/collision/forearm.stl"/>
    <mesh name="wrist1" content_type="model/stl" file="ur5/collision/wrist1.stl"/>
    <mesh name="wrist2" content_type="model/stl" file="ur5/collision/wrist2.stl"/>
